#!/usr/bin/make -f
# Builds offline (Launchpad has no network): the crates are vendored into
# vendor/ in the orig tarball by pkg/deb/build-ppa.sh.

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/target

# ZestBay needs Rust >= 1.88 (edition 2024 with let chains). Use the newest versioned toolchain
# (rust-1.NN) if installed, otherwise the default one.
RUST_BIN := $(lastword $(sort $(wildcard /usr/lib/rust-1.*/bin)))
ifneq ($(RUST_BIN),)
export PATH := $(RUST_BIN):$(PATH)
endif

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(CARGO_HOME)
	printf '%s\n' \
	  '[source.crates-io]' 'replace-with = "vendored-sources"' \
	  '[source.vendored-sources]' 'directory = "$(CURDIR)/vendor"' \
	  > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo --version
	cargo build --workspace --release --offline --locked
	$(MAKE) -C zestins BUILD=$(CURDIR)/target/zestins \
	  CFLAGS="$(shell dpkg-buildflags --get CFLAGS)" \
	  LDFLAGS="$(shell dpkg-buildflags --get LDFLAGS)"

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/zestbay debian/zestbay/usr/bin/zestbay
	install -Dm755 target/release/zestbay-ui-bridge debian/zestbay/usr/lib/zestbay/zestbay-ui-bridge
	install -Dm644 zestbay.desktop debian/zestbay/usr/share/applications/zestbay.desktop
	install -Dm644 images/logo/zestbay-launcher.svg debian/zestbay/usr/share/icons/hicolor/scalable/apps/zestbay.svg
	install -Dm644 images/zesticon.png debian/zestbay/usr/share/icons/hicolor/256x256/apps/zestbay.png
	install -Dm644 images/zesttray.png debian/zestbay/usr/share/icons/hicolor/256x256/apps/zestbay-tray.png
	$(MAKE) -C zestins BUILD=$(CURDIR)/target/zestins install \
	  CFLAGS="$(shell dpkg-buildflags --get CFLAGS)" \
	  LDFLAGS="$(shell dpkg-buildflags --get LDFLAGS)" \
	  DESTDIR=$(CURDIR)/debian/zestins LV2_DIR=/usr/lib/lv2

# Rust binaries: dwz has nothing useful to do and can fail on them
override_dh_dwz:

override_dh_auto_clean:
	rm -rf $(CARGO_HOME) target
